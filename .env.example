# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ===== GEMINI API =====
# Required: Get from https://aistudio.google.com/app/apikeys
# Used for: Name screening + Face/Vision screening
GOOGLE_API_KEY=

# Model (default: gemini-3.1-pro-preview)
GOOGLE_MODEL=gemini-3.1-pro-preview

# Optional: override system instructions (otherwise uses prompts/screening-agent-system.md)
# GREECE_COMPLIANCE_SYSTEM_PROMPT=

# Set to "true" to always use mock data (even if API key is set)
USE_MOCK_AGENT=false
